{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mixudev/laravel-sso-client",
    "description": "Secure OAuth 2.0 and OpenID Connect client integration for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/session": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "MixuDev\\LaravelSsoClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MixuDev\\LaravelSsoClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MixuDev\\LaravelSsoClient\\LaravelSsoClientServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --colors=always",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
